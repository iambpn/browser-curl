{
  "private": true,
  "name": "browser-curl",
  "description": "Send HTTP requests and import cURL commands from the browser sidebar.",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/chrome": "^0.0.287",
    "extension": "^4.1.35",
    "typescript": "7.0.2"
  },
  "scripts": {
    "test": "node --test tests/",
    "test:browser": "npm run build && node tests/browser/run.mjs",
    "test:e2e": "npm run build && playwright test",
