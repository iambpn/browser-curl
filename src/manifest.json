{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "chromium:manifest_version": 3,
  "firefox:manifest_version": 2,
  "version": "1.0.0",
  "firefox:browser_specific_settings": {
    "gecko": {
      "id": "{02f04740-a0dc-4d04-afb4-1bb8593ad7f4}",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "name": "browsercurl",
  "description": "Rest API client that send HTTP requests and import cURL commands from the browser sidebar.",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "64": "images/icon-64.png",
    "128": "images/icon-128.png"
  },
  "chromium:action": {
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "64": "images/icon-64.png",
      "128": "images/icon-128.png"
    },
    "default_title": "Open browsercurl"
  },
  "firefox:browser_action": {
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "64": "images/icon-64.png",
      "128": "images/icon-128.png"
    },
    "default_title": "Open browsercurl"
  },
  "chromium:side_panel": {
    "default_path": "sidebar/index.html",
    "default_title": "browsercurl"
  },
  "firefox:sidebar_action": {
    "default_panel": "sidebar/index.html",
    "default_title": "browsercurl",
    "browser_style": false
  },
  "chromium:permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "declarativeNetRequestWithHostAccess"
  ],
  "chromium:host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "firefox:permissions": [
    "storage",
    "unlimitedStorage",
    "webRequest",
    "webRequestBlocking",
    "http://*/*",
    "https://*/*"
  ],
  "chromium:content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "firefox:content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
  "background": {
    "chromium:service_worker": "background.ts",
    "firefox:scripts": [
      "background.ts"
    ]
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  }
}
